# Copie para .env.local (ou configure via Secret Manager em produção) -- nunca
# preencher valores reais aqui, este arquivo é versionado (docs/SEGURANCA.md).

# Supabase (local: valores impressos por `npx supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=[MASKED]
SUPABASE_SERVICE_ROLE_KEY=[MASKED]

# CORS -- lista separada por vírgula, sem protocolo/porta implícita omitida
APP_ALLOWED_ORIGINS=http://localhost:5173

PORT=3002

# Cofre de certificados digitais (Modo B, docs/SEGURANCA.md §1) -- 32 bytes base64,
# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca reaproveitar entre ambientes, nunca versionar um valor real.
CERTIFICADO_CHAVE_MESTRA=[MASKED]

# Assinatura SaaS (contador -> Jota via Stripe Checkout/Subscriptions, sem Connect,
# docs/SEGURANCA.md §6). Pegar em dashboard.stripe.com (modo teste primeiro) -- secret
# key em Developers > API keys, webhook secret ao criar o endpoint em Developers > Webhooks
# apontando pra /webhooks/stripe/assinaturas.
STRIPE_SECRET_KEY=[MASKED]
STRIPE_WEBHOOK_SECRET_ASSINATURAS=[MASKED]

# Honorários (Stripe Connect, docs/SEGURANCA.md §7) -- mesma STRIPE_SECRET_KEY acima,
# webhook secret próprio (endpoint separado apontando pra /webhooks/stripe/honorarios,
# escutando account.updated + payment_intent.succeeded/payment_failed).
STRIPE_WEBHOOK_SECRET_HONORARIOS=[MASKED]

# Licenciamento de pacotes de módulos, compra no atacado (Stripe Subscription, sem
# Connect) -- mesma STRIPE_SECRET_KEY acima, webhook secret próprio (endpoint separado
# apontando pra /webhooks/stripe/licencas-modulo, escutando invoice.paid +
# customer.subscription.deleted).
STRIPE_WEBHOOK_SECRET_LICENCAS=[MASKED]

# PagBank -- split de pagamento na ativação de pacote de módulos pra empresa-cliente
# (plataforma fica com pacotes_modulos.preco, contador com a margem do próprio plano de
# revenda). Token da conta Marketplace/Facilitador da Jota -- NUNCA fica no banco, só
# aqui (mesmo tratamento de credencial sensível que STRIPE_SECRET_KEY recebe). Conta
# PagBank de cada contador é cadastrada por ele via PATCH /contadores/:id/pagbank-conta,
# não por env var.
PAGBANK_PLATFORM_TOKEN=[MASKED]
PAGBANK_SANDBOX=true
PAGBANK_WEBHOOK_URL=http://localhost:3002/webhooks/pagbank/licencas-modulo

# SERPRO / Integra Contador (docs/SEGURANCA.md §3) -- trial não exige nenhuma das
# variáveis abaixo (token público, sem certificado); só produção exige.
SERPRO_AMBIENTE=trial
# SERPRO_TRIAL_TOKEN=      # opcional -- só se o SERPRO trocar o token público de demonstração
# SERPRO_CONSUMER_KEY=[MASKED]        # produção apenas
# SERPRO_CONSUMER_SECRET=[MASKED]     # produção apenas
# SERPRO_CERTIFICADO_PATH=            # produção apenas -- caminho pro .pfx/.p12 da Jota, NUNCA versionado
# SERPRO_CERTIFICADO_SENHA=[MASKED]   # produção apenas
# SERPRO_CONTRATANTE_CNPJ=            # produção apenas -- CNPJ da Jota
