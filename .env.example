# Copie para .env.local (ou configure via Secret Manager em produção) -- nunca
# preencher valores reais aqui, este arquivo é versionado (docs/SEGURANCA.md).

# Supabase (local: valores impressos por `npx supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=[MASKED]
SUPABASE_SERVICE_ROLE_KEY=[MASKED]

# CORS -- lista separada por vírgula, sem protocolo/porta implícita omitida
APP_ALLOWED_ORIGINS=http://localhost:5173

PORT=3002

# Cofre de certificados digitais (Modo B, docs/SEGURANCA.md §1) -- 32 bytes base64,
# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca reaproveitar entre ambientes, nunca versionar um valor real.
CERTIFICADO_CHAVE_MESTRA=[MASKED]

# Segredo do Auth Hook "Password Verification Attempt" (src/supabase-hooks/) -- mesmo
# valor configurado no painel do Supabase (produção) ou supabase/config.toml (local, via
# env var SUPABASE_AUTH_HOOK_SECRET no shell que roda `supabase start`, não aqui).
# Gerar com: node -e "console.log('v1,whsec_' + require('crypto').randomBytes(32).toString('base64'))"
SUPABASE_AUTH_HOOK_SECRET=[MASKED]

# 2FA por email (src/common/email/email-2fa.service.ts) -- opcional: sem isso, método
# 'email' de 2FA fica indisponível (falha só quando alguém tenta usar, não trava o app
# inteiro). Criar conta em resend.com, domínio verificado, gerar API key.
# RESEND_API_KEY=[MASKED]
# RESEND_2FA_FROM=JOTA FISCAL <nao-responda@seudominio.com.br>

# PagBank -- split de pagamento em assinatura/créditos-avulsos/licenças/honorários pra
# empresa-cliente (plataforma fica com a comissão, contador com a margem). Único gateway
# de pagamento do sistema (Stripe removido por completo em 2026-10). Token da conta
# Marketplace/Facilitador da Jota -- NUNCA fica no banco, só aqui (mesmo tratamento de
# credencial sensível que qualquer secret key de gateway recebe). Conta PagBank de cada
# contador é cadastrada por ele via PATCH /contadores/:id/pagbank-conta, não por env var.
PAGBANK_PLATFORM_TOKEN=[MASKED]
PAGBANK_SANDBOX=true
# Só a base -- cada usecase de cobrança completa com o path do PRÓPRIO webhook (ex:
# /webhooks/pagbank/creditos-avulsos). Nunca fixar um path aqui (ver PagbankConfigService).
PAGBANK_WEBHOOK_BASE_URL=http://localhost:3002

# SERPRO / Integra Contador (docs/SEGURANCA.md §3) -- trial não exige nenhuma das
# variáveis abaixo (token público, sem certificado); só produção exige.
SERPRO_AMBIENTE=trial
# SERPRO_TRIAL_TOKEN=      # opcional -- só se o SERPRO trocar o token público de demonstração
# SERPRO_CONSUMER_KEY=[MASKED]        # produção apenas
# SERPRO_CONSUMER_SECRET=[MASKED]     # produção apenas
# SERPRO_CERTIFICADO_PATH=            # produção apenas -- caminho pro .pfx/.p12 da Jota, NUNCA versionado
# SERPRO_CERTIFICADO_SENHA=[MASKED]   # produção apenas
# SERPRO_CONTRATANTE_CNPJ=            # produção apenas -- CNPJ da Jota
